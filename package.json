{
  "name": "tsgoblin",
  "version": "0.3.1",
  "description": "Fast, vue-tsc-parity Vue SFC type-checking powered by the native TypeScript compiler (tsgo).",
  "type": "module",
  "bin": {
    "tsgoblin": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "selftest": "node test/selftest.mjs",
    "parity": "node test/parity.mjs",
    "engine": "node test/engine.mjs",
    "build-test": "node test/build.mjs",
    "test": "node test/selftest.mjs && node test/parity.mjs && node test/engine.mjs && node test/build.mjs",
    "prepublishOnly": "node test/selftest.mjs && node test/parity.mjs && node test/engine.mjs && node test/build.mjs"
  },
  "keywords": [
    "vue",
    "vue-tsc",
    "tsgo",
    "typescript",
    "type-check",
    "volar",
    "sfc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alice-edu/tsgoblin.git"
  },
  "dependencies": {
    "@volar/language-core": "2.4.27",
    "@vue/language-core": "3.2.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@typescript/native-preview": "*"
  },
  "peerDependenciesMeta": {
    "@typescript/native-preview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vue": "^3.5.39",
    "vue-tsc": "3.2.2"
  }
}
